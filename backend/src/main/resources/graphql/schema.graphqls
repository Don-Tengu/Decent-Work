type User {
    id: ID!
    email: String!
    username: String!
    role: UserRole!
    walletAddress: String
    profile: UserProfile
    createdAt: String!
}

type UserProfile {
    fullName: String
    bio: String
    skills: [String!]
    hourlyRate: Float
    profileImage: String
}

enum UserRole {
    FREELANCER
    CLIENT
}

type Job {
    id: ID!
    title: String!
    description: String!
    status: JobStatus!
    draftStep: JobDraftStep
    scopeSize: JobScopeSize
    scopeDurationAmount: Int
    scopeDurationUnit: ScopeDurationUnit
    scopeDurationDays: Int
    experienceLevel: ExperienceLevel
    contractToHire: Boolean!
    budgetType: BudgetType!
    hourlyRateMin: Float
    hourlyRateMax: Float
    fixedBudget: Float
    currencyCode: String!
    paymentModel: PaymentModel!
    category: SkillTaxonomyNode
    specialty: SkillTaxonomyNode
    skills: [Skill!]! @deprecated(reason: "Use jobSkillTags for built-in and custom job skills.")
    jobSkillTags: [JobSkillTag!]!
    attachments: [JobAttachment!]!
    client: User!
    bids: [Bid!]!
    acceptedBid: Bid
    escrowAddress: String
    createdAt: String!
    updatedAt: String!
    publishedAt: String
}

type JobPage {
    content: [Job!]!
    totalElements: Int!
    totalPages: Int!
    page: Int!
    size: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

enum JobStatus {
    DRAFT
    OPEN
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum JobDraftStep {
    SKILLS
    SCOPE
    BUDGET
    DETAILS
    REVIEW
}

enum JobScopeSize {
    SMALL
    MEDIUM
    LARGE
}

enum ScopeDurationUnit {
    DAY
    WEEK
    MONTH
    YEAR
}

enum ExperienceLevel {
    ENTRY
    INTERMEDIATE
    EXPERT
}

enum BudgetType {
    HOURLY
    FIXED
    NOT_READY
}

enum PaymentModel {
    OFF_CHAIN_NEGOTIATED
    ON_CHAIN_ESCROW
    ON_CHAIN_MILESTONE_ESCROW
}

enum JobSort {
    BEST_MATCH
    MOST_RECENT
}

type Skill {
    id: ID!
    name: String!
    slug: String!
    normalizedName: String!
    isActive: Boolean!
    isVerified: Boolean!
    createdByUser: User
    taxonomyNodes: [SkillTaxonomyNode!]!
    createdAt: String!
}

type JobSkillTag {
    id: ID!
    skill: Skill
    skillId: ID
    name: String!
    custom: Boolean!
    displayOrder: Int!
}

type SkillTaxonomyNode {
    id: ID!
    name: String!
    slug: String!
    normalizedName: String!
    level: SkillTaxonomyLevel!
    parent: SkillTaxonomyNode
    children: [SkillTaxonomyNode!]!
    displayOrder: Int!
    isActive: Boolean!
    createdAt: String!
}

enum SkillTaxonomyLevel {
    CATEGORY
    SUBCATEGORY
    SPECIALTY
}

type JobAttachment {
    id: ID!
    storageProvider: JobAttachmentStorageProvider!
    storageKey: String!
    fileName: String!
    contentType: String
    fileSizeBytes: Float!
    uploadedByUser: User!
    publicUrl: String
    ipfsCid: String
    sha256Hash: String
    createdAt: String!
}

enum JobAttachmentStorageProvider {
    LOCAL
    S3
    IPFS
}

type BidAttachment {
    id: ID!
    storageProvider: BidAttachmentStorageProvider!
    storageKey: String!
    fileName: String!
    contentType: String
    fileSizeBytes: Float!
    uploadedByUser: User!
    publicUrl: String
    ipfsCid: String
    sha256Hash: String
    createdAt: String!
}

enum BidAttachmentStorageProvider {
    LOCAL
    S3
    IPFS
}

type Bid {
    id: ID!
    amount: Float!
    proposal: String!
    relevantExperience: String
    deliveryTime: Int!
    status: BidStatus!
    freelancer: User!
    job: Job!
    """Present when this proposal was hired (accepted bid)."""
    payment: Payment
    attachments: [BidAttachment!]!
    createdAt: String!
}

enum BidStatus {
    PENDING
    OFFERED
    ACCEPTED
    REJECTED
}

type Notification {
    id: ID!
    type: NotificationType!
    title: String!
    message: String!
    linkPath: String!
    read: Boolean!
    jobId: ID
    bidId: ID
    createdAt: String!
}

enum NotificationType {
    OFFER_RECEIVED
    OFFER_ACCEPTED
    OFFER_DECLINED
    OFFER_WITHDRAWN
    BID_NOT_SELECTED
    WORK_SUBMITTED
    CHANGES_REQUESTED
}

type Payment {
    id: ID!
    amount: Float!
    amountWei: String
    status: PaymentStatus!
    fundingMode: FundingMode!
    transactionHash: String
    fundTransactionHash: String
    releaseTransactionHash: String
    onChainEscrowId: String
    chainId: Int
    escrowAddress: String!
    clientWallet: String
    freelancerWallet: String
    platformFeePercent: Int
    job: Job!
    freelancer: User!
    client: User!
    createdAt: String!
    workSubmittedAt: String
    workSubmissionMessage: String
    changesRequestedAt: String
    changesRequestedMessage: String
}

enum PaymentStatus {
    AWAITING_FUNDING
    ESCROWED
    IN_REVIEW
    RELEASED
    REFUNDED
}

enum FundingMode {
    SIMULATED
    ON_CHAIN
}

type AuthPayload {
    token: String!
    user: User!
}

type Query {
    # User queries
    me: User
    user(id: ID!): User

    # Job queries
    jobs(status: JobStatus, limit: Int, offset: Int): [Job!]!
    jobsPage(
        status: JobStatus
        query: String
        categoryId: ID
        categoryIds: [ID!]
        specialtyIds: [ID!]
        experienceLevels: [ExperienceLevel!]
        budgetTypes: [BudgetType!]
        page: Int
        size: Int
        sort: JobSort
    ): JobPage!
    job(id: ID!): Job
    myJobs(statuses: [JobStatus!]): [Job!]!
    mySavedJobs: [Job!]!
    savedJobIds: [ID!]!
    skills(query: String, limit: Int): [Skill!]!
    skillTaxonomy: [SkillTaxonomyNode!]!

    # Bid queries
    myBids: [Bid!]!
    jobBids(jobId: ID!): [Bid!]!
    myBidForJob(jobId: ID!): Bid

    # Payment queries
    paymentForJob(jobId: ID!): Payment

    # Notifications
    myNotifications(limit: Int): [Notification!]!
    unreadNotificationCount: Int!
}

type Mutation {
    # Auth
    register(input: RegisterInput!): AuthPayload!
    login(email: String!, password: String!): AuthPayload!

    # User
    updateProfile(input: UpdateProfileInput!): User!
    connectWallet(walletAddress: String!): User!

    # Job
    createJob(input: CreateJobInput!): Job!
    saveJobDraft(id: ID, input: SaveJobDraftInput!): Job!
    publishJob(id: ID, input: CreateJobInput!): Job!
    updateJob(id: ID!, input: UpdateJobInput!): Job!
    """Remove a job you own. Unpublished drafts are deleted with their skill tags and attachments; open postings are cancelled."""
    cancelJob(id: ID!): Job!
    saveJob(id: ID!): Job!
    unsaveJob(id: ID!): Job!

    # Bid / offers
    placeBid(input: PlaceBidInput!): Bid!
    """Client sends an offer for a pending proposal. Does not reject others or create payment."""
    offerBid(bidId: ID!): Bid!
    """Freelancer accepts an outstanding offer; creates payment and starts the job."""
    acceptOffer(bidId: ID!): Payment!
    """Freelancer declines an offer; proposal returns to PENDING."""
    declineOffer(bidId: ID!): Bid!
    """Client withdraws an outstanding offer; proposal returns to PENDING."""
    withdrawOffer(bidId: ID!): Bid!

    # Notifications
    markNotificationRead(id: ID!): Notification!
    markAllNotificationsRead: Boolean!

    # Payment
    """Confirm on-chain createEscrow funding (ON_CHAIN payments)."""
    confirmEscrowFunding(paymentId: ID!, transactionHash: String!): Payment!
    """Confirm on-chain releasePayment (ON_CHAIN payments)."""
    confirmPaymentRelease(paymentId: ID!, transactionHash: String!): Payment!
    """Simulated release for OFF_CHAIN payments; on-chain requires transactionHash + verification. Allowed from ESCROWED or IN_REVIEW."""
    releasePayment(paymentId: ID!, transactionHash: String): Payment!
    """Hired freelancer submits completed work for client review. Payment must be ESCROWED."""
    submitWork(jobId: ID!, message: String): Payment!
    """Client requests changes on submitted work. Payment must be IN_REVIEW; funds stay in escrow."""
    requestChanges(jobId: ID!, message: String): Payment!
}

input RegisterInput {
    email: String!
    username: String!
    password: String!
    role: UserRole!
    walletAddress: String
}

input UpdateProfileInput {
    fullName: String
    bio: String
    skills: [String!]
    hourlyRate: Float
    profileImage: String
}

input CreateJobInput {
    title: String!
    description: String!
    categoryId: ID!
    specialtyId: ID!
    skillIds: [ID!]!
    customSkillNames: [String!]
    scopeSize: JobScopeSize!
    scopeDurationAmount: Int!
    scopeDurationUnit: ScopeDurationUnit!
    experienceLevel: ExperienceLevel!
    contractToHire: Boolean!
    budgetType: BudgetType!
    hourlyRateMin: Float
    hourlyRateMax: Float
    fixedBudget: Float
    currencyCode: String = "USDC"
    paymentModel: PaymentModel = ON_CHAIN_ESCROW
}

input SaveJobDraftInput {
    title: String
    description: String
    categoryId: ID
    specialtyId: ID
    skillIds: [ID!]
    customSkillNames: [String!]
    draftStep: JobDraftStep
    scopeSize: JobScopeSize
    scopeDurationAmount: Int
    scopeDurationUnit: ScopeDurationUnit
    experienceLevel: ExperienceLevel
    contractToHire: Boolean
    budgetType: BudgetType
    hourlyRateMin: Float
    hourlyRateMax: Float
    fixedBudget: Float
    currencyCode: String
    paymentModel: PaymentModel
}

input UpdateJobInput {
    title: String
    description: String
    categoryId: ID
    specialtyId: ID
    skillIds: [ID!]
    customSkillNames: [String!]
    scopeSize: JobScopeSize
    scopeDurationAmount: Int
    scopeDurationUnit: ScopeDurationUnit
    experienceLevel: ExperienceLevel
    contractToHire: Boolean
    budgetType: BudgetType
    hourlyRateMin: Float
    hourlyRateMax: Float
    fixedBudget: Float
    currencyCode: String
    paymentModel: PaymentModel
    status: JobStatus
}

input PlaceBidInput {
    jobId: ID!
    amount: Float!
    proposal: String!
    relevantExperience: String
    deliveryTime: Int!
}
