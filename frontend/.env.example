# Variable catalog. Mode files:
#   .env.development  — 本地  (`npm run dev`)
#   .env.sepolia      — 开发  (`npm run dev:sepolia`)
#   .env.production   — 生产  (`npm run build`)
# Machine-specific overrides: `.env.[mode].local` (gitignored).

VITE_API_BASE_URL=http://localhost:8080

# anvil | base-sepolia | base
VITE_CHAIN_KEY=anvil

# Per-deployment escrow (from forge / make deploy-local). Required.
VITE_ESCROW_ADDRESS=

# Optional overrides — token address/decimals come from src/config/tokens.js
# VITE_TOKEN_ADDRESS=
# VITE_TOKEN_SYMBOL=USDC
# VITE_TOKEN_DECIMALS=6
# VITE_CHAIN_ID=31337
# VITE_CHAIN_NAME=Anvil
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_BLOCK_EXPLORER_URL=
# VITE_PLATFORM_FEE_PERCENT=5
